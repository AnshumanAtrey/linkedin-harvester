# Copy to .env and fill in. Every key is OPTIONAL - the tool degrades gracefully.
# The .env file is gitignored so your real keys never get committed.

# AI brain (Groq free tier is generous). Needed only for Balanced/Full AI flows.
# Get one at https://console.groq.com/keys  (starts with gsk_)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Search for the retrieve step. Brave is primary; Google CSE is a legacy fallback.
# Brave: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_key_here
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Pipeline config
CONFIDENCE_THRESHOLD=0.80
